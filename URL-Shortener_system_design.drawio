  <diagram id="YSmcDlKGOf5e294pN5pc" name="03. Database Design &amp; Data Modeling">
    <mxGraphModel dx="1106" dy="644" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gVjoNq1FSSi5XgvC9omh-1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1a73e8;" value="URL Shortener System Design" vertex="1">
          <mxGeometry height="30" width="600" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-2" parent="1" style="text;html=1;fontSize=14;fontColor=#5f6368;" value="Diagram 3 – Database Design" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-3" parent="1" style="swimlane;startSize=30;fillColor=#f8f9fa;strokeColor=#bdc3c7;html=1;fontStyle=1;align=left;leftValign=middle;fontColor=#202124;" value="SECTION 1: DATABASE SELECTION" vertex="1">
          <mxGeometry height="280" width="520" x="20" y="100" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-4" parent="gVjoNq1FSSi5XgvC9omh-3" style="rounded=1;fillColor=#e8f0fe;strokeColor=#1a73e8;html=1;align=left;valign=top;spacing=8;fontColor=#1a73e8;" value="&lt;b&gt;SQL (MySQL/PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Advantages:&lt;/b&gt;&lt;br&gt;• ACID Transactions&lt;br&gt;• Strong Consistency&lt;br&gt;• Efficient Indexing&lt;br&gt;• Supports Constraints&lt;br&gt;&lt;br&gt;&lt;b&gt;Disadvantages:&lt;/b&gt;&lt;br&gt;• Harder Horizontal Scaling" vertex="1">
          <mxGeometry height="150" width="235" x="15" y="45" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-5" parent="gVjoNq1FSSi5XgvC9omh-3" style="rounded=1;fillColor=#f1f3f4;strokeColor=#9aa0a6;html=1;align=left;valign=top;spacing=8;fontColor=#5f6368;" value="&lt;b&gt;NoSQL (MongoDB)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Advantages:&lt;/b&gt;&lt;br&gt;• Flexible Schema&lt;br&gt;• Easy Horizontal Scaling&lt;br&gt;&lt;br&gt;&lt;b&gt;Disadvantages:&lt;/b&gt;&lt;br&gt;• Eventual Consistency&lt;br&gt;• Complex Unique Constraints" vertex="1">
          <mxGeometry height="150" width="235" x="270" y="45" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-6" parent="gVjoNq1FSSi5XgvC9omh-3" style="rounded=1;fillColor=#e6f4ea;strokeColor=#137333;html=1;align=left;valign=middle;spacing=10;fontColor=#137333;" value="&lt;b&gt;FINAL CHOICE: MySQL (SQL)&lt;/b&gt;&lt;br&gt;URL mappings require strong consistency and unique constraints on short_code to prevent collisions." vertex="1">
          <mxGeometry height="60" width="490" x="15" y="205" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-7" parent="1" style="swimlane;startSize=30;fillColor=#f8f9fa;strokeColor=#bdc3c7;html=1;fontStyle=1;align=left;leftValign=middle;fontColor=#202124;" value="SECTION 2: ER DIAGRAM" vertex="1">
          <mxGeometry height="280" width="520" x="580" y="100" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-8" parent="gVjoNq1FSSi5XgvC9omh-7" style="shape=cylinder3;fillColor=#e8f0fe;strokeColor=#1a73e8;html=1;fontColor=#1a73e8;" value="&lt;b&gt;MySQL&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="80" x="20" y="110" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-9" parent="gVjoNq1FSSi5XgvC9omh-7" style="rounded=1;fillColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;html=1;align=left;valign=top;spacing=8;fontColor=#202124;" value="&lt;b&gt;URLs Table&lt;/b&gt;&lt;hr&gt;🔑 &lt;b&gt;id&lt;/b&gt;: BIGINT (PK)&lt;br&gt;✨ &lt;b&gt;short_code&lt;/b&gt;: VARCHAR(10) (UNIQUE)&lt;br&gt;🔗 &lt;b&gt;original_url&lt;/b&gt;: TEXT&lt;br&gt;📅 &lt;b&gt;created_at&lt;/b&gt;: TIMESTAMP&lt;br&gt;⏳ &lt;b&gt;expires_at&lt;/b&gt;: TIMESTAMP&lt;br&gt;📈 &lt;b&gt;click_count&lt;/b&gt;: BIGINT&lt;br&gt;🚦 &lt;b&gt;status&lt;/b&gt;: ENUM" vertex="1">
          <mxGeometry height="220" width="360" x="140" y="45" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-10" edge="1" parent="gVjoNq1FSSi5XgvC9omh-7" source="gVjoNq1FSSi5XgvC9omh-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1a73e8;strokeWidth=2;endArrow=block;endFill=1;" target="gVjoNq1FSSi5XgvC9omh-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-11" parent="1" style="swimlane;startSize=30;fillColor=#f8f9fa;strokeColor=#bdc3c7;html=1;fontStyle=1;align=left;leftValign=middle;fontColor=#202124;" value="SECTION 3: INDEX STRATEGY" vertex="1">
          <mxGeometry height="240" width="520" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="gVjoNq1FSSi5XgvC9omh-12" parent="gVjoNq1FSSi5XgvC9omh-11" style="rounded=1;fillColor=#e8f0fe;strokeColor=#1a73e8;html=1;align=center;valign=top;spacing=8;fontColor=#1a73e8;" value="&lt;b&gt;Primary Key Index&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Target:&lt;/b&gt;&lt;br&gt;id&lt;br&gt;&lt;br&gt;⬇️&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt;&lt;br&gt;Fast lookup by ID" vertex="1">
          <mxGeometry height="170" width="150" x="15" y="50" as="geometry" />
