  <diagram id="R5JPGfiYMVFIMx6abLDN" name="05. URL Generation Strategy">
    <mxGraphModel dx="1032" dy="601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" value="&lt;b&gt;URL Shortener System Design&lt;/b&gt;&lt;br&gt;Diagram 5: URL Generation Strategy (Auto-Increment ID &amp;amp; Base62 Encoding)" vertex="1">
          <mxGeometry height="50" width="1000" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;valign=top;spacingLeft=12;spacingRight=12;spacingTop=10;fontSize=11;html=1;" value="&lt;b&gt;System Context&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;Goal:&lt;/b&gt; Convert long URLs to short, unique aliases.&lt;br&gt;• &lt;b&gt;Core Mechanism:&lt;/b&gt; DB Auto-Increment ID + Base62 Encoding.&lt;br&gt;• &lt;b&gt;Scope:&lt;/b&gt; High-throughput, low-latency generation with zero collision risk." vertex="1">
          <mxGeometry height="150" width="310" x="20" y="100" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;valign=top;spacingLeft=12;spacingRight=12;spacingTop=10;fontSize=11;html=1;" value="&lt;b&gt;Example Conversion&lt;/b&gt;&lt;hr&gt;&lt;b&gt;1. Numeric ID (Base10):&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0066cc&quot;&gt;&lt;b&gt;12567891&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Base62 Conversion Math:&lt;/b&gt;&lt;br&gt;12567891 = 7×62³ + 15×62² + ...&lt;br&gt;Resulting Character Codes: [10, 35, 9, 1, 11, 38]&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Base62 String:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;&lt;b&gt;aZ91Bc&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="20" y="270" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;valign=top;spacingLeft=12;spacingRight=12;spacingTop=10;fontSize=11;html=1;" value="&lt;b&gt;Collision Prevention&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;Guaranteed Uniqueness:&lt;/b&gt; Auto-increment IDs provide a strictly increasing, unique sequence.&lt;br&gt;• &lt;b&gt;Single Encoding:&lt;/b&gt; Each ID is mapped to exactly one Base62 string.&lt;br&gt;• &lt;b&gt;No Collisions:&lt;/b&gt; Unlike hashing (MD5/SHA256), math-based base conversion has zero collision risk." vertex="1">
          <mxGeometry height="200" width="310" x="20" y="480" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;html=1;" value="&lt;b&gt;Step 1: Long URL Input&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;https://www.google.com/search/system-design&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="360" y="100" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;html=1;" value="&lt;b&gt;Step 2: Validate URL&lt;/b&gt;&lt;br&gt;• Format Validation &amp;amp; HTTP/HTTPS Check&lt;br&gt;• Safe Browsing API Check (Malware/Spam)&lt;br&gt;• Duplicate Detection (Optional Cache Lookup)" vertex="1">
          <mxGeometry height="75" width="320" x="360" y="190" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;html=1;" value="&lt;b&gt;Step 3: Generate Unique ID&lt;/b&gt;&lt;br&gt;Auto-Increment Primary Key (Database/KGS)&lt;br&gt;&lt;font color=&quot;#0066cc&quot;&gt;&lt;b&gt;Generated ID: 12567891&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="360" y="295" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;html=1;" value="&lt;b&gt;Step 4: Base62 Encoder&lt;/b&gt;&lt;br&gt;Convert Numeric ID to Base62 String&lt;br&gt;&lt;font color=&quot;#b57c00&quot;&gt;&lt;b&gt;12567891  ―――&amp;gt;  aZ91Bc&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="320" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;html=1;" value="&lt;b&gt;Step 5: Store URL Mapping&lt;/b&gt;&lt;br&gt;Save to MySQL / NoSQL Database&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;short_code: &lt;b&gt;aZ91Bc&lt;/b&gt;&lt;br&gt;original_url: https://www.google.com/...&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="320" x="360" y="505" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;html=1;" value="&lt;b&gt;Step 6: Return Short URL&lt;/b&gt;&lt;br&gt;Construct and return the shortened alias&lt;br&gt;&lt;font color=&quot;#274e13&quot;&gt;&lt;b&gt;https://tiny.ly/aZ91Bc&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="360" y="620" as="geometry" />
        </mxCell>
        <mxCell id="GqSjYbr0GGbmEA5FE7m0-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;valign=top;spacingLeft=12;spacingRight=12;spacingTop=10;fontSize=11;html=1;" value="&lt;b&gt;Base62 Character Set&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;0 – 9&lt;/b&gt; (10 characters)&lt;br&gt;• &lt;b&gt;A – Z&lt;/b&gt; (26 characters)&lt;br&gt;• &lt;b&gt;a – z&lt;/b&gt; (26 characters)&lt;br&gt;&lt;br&gt;&lt;b&gt;Total Characters = 62&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provides 62^6 (~56.8 Billion) unique combinations for a 6-character short code." vertex="1">
          <mxGeometry height="180" width="310" x="710" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mr32NCE_ySoCO1zEAxtP" name="06. Basic System Architecture (Version 1)">
    <mxGraphModel dx="1290" dy="752" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2jhapH6LsP5_bRsLbSqy-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#1a73e8;fontSize=13;" value="&lt;b&gt;👤 User&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot;&gt;(Browser / Mobile App)&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="240" y="100" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;💻 URL Shortener Server&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid; border-color:#1a73e8; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 8px; line-height: 1.4;&quot;&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Validate URL&lt;br&gt;• Generate Base62 Short Code&lt;br&gt;• Store URL Mapping&lt;br&gt;• Redirect Users&lt;br&gt;• Handle REST APIs&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="210" y="260" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-4" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=2;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;🗄️ MySQL Database&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid; border-color:#5f6368; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 12px; line-height: 1.4;&quot;&gt;&lt;b&gt;URLs Table&lt;/b&gt;&lt;br&gt;• id &lt;font color=&quot;#70757a&quot;&gt;(BIGINT, PK)&lt;/font&gt;&lt;br&gt;• short_code &lt;font color=&quot;#70757a&quot;&gt;(VARCHAR)&lt;/font&gt;&lt;br&gt;• original_url &lt;font color=&quot;#70757a&quot;&gt;(TEXT)&lt;/font&gt;&lt;br&gt;• created_at &lt;font color=&quot;#70757a&quot;&gt;(TIMESTAMP)&lt;/font&gt;&lt;br&gt;• expires_at &lt;font color=&quot;#70757a&quot;&gt;(TIMESTAMP)&lt;/font&gt;&lt;br&gt;• click_count &lt;font color=&quot;#70757a&quot;&gt;(INT)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="220" x="220" y="520" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#137333;strokeWidth=2;fontColor=#137333;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;📋 Assumptions&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid; border-color:#137333; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 8px; line-height: 1.5;&quot;&gt;• Single Application Server&lt;br&gt;• Single Database&lt;br&gt;• No Redis Cache&lt;br&gt;• No Load Balancer&lt;br&gt;• No Analytics Service&lt;br&gt;• Suitable for small traffic&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="260" x="520" y="160" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;strokeWidth=2;fontColor=#c5221f;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;⚠️ Limitations&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid; border-color:#c5221f; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 8px; line-height: 1.5;&quot;&gt;❌ Single Point of Failure&lt;br&gt;❌ Database handles every request&lt;br&gt;❌ Cannot scale for millions of users&lt;br&gt;❌ No Fault Tolerance&lt;br&gt;❌ Low Availability&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="260" x="520" y="360" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-7" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5f6368;" value="&lt;b&gt;Version 1&lt;/b&gt;   |   &lt;b&gt;Basic Architecture&lt;/b&gt;   |   &lt;b&gt;Diagram 6 of 12&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="100" y="740" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-8" edge="1" parent="1" source="2jhapH6LsP5_bRsLbSqy-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1a73e8;strokeWidth=2;fontColor=#1a73e8;fontSize=11;align=center;startArrow=classic;startFill=1;endArrow=classic;endFill=1;" target="2jhapH6LsP5_bRsLbSqy-3" value="POST /shorten&lt;br&gt;GET /{shortCode}">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2jhapH6LsP5_bRsLbSqy-9" edge="1" parent="1" source="2jhapH6LsP5_bRsLbSqy-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;fontColor=#5f6368;fontSize=11;align=center;startArrow=classic;startFill=1;endArrow=classic;endFill=1;" target="2jhapH6LsP5_bRsLbSqy-4" value="Read URL Mapping&lt;br&gt;Write URL Mapping">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YY8rFSP_1wfnmmISGudZ-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;URL Shortener System Design&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0066cc&quot;&gt;Diagram 6:Basic System Architecture&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0066cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="600" x="310" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="JlncdVhnqyMCT6aoEM1j" name="07. Scaling the Application Layer (Version 2)">
    <mxGraphModel dx="774" dy="451" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;URL Shortener System Design&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#0066cc&quot;&gt;Diagram 7: Scaling Compute&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="600" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontColor=#000000;" value="&lt;b&gt;User&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="80" x="440" y="90" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontColor=#000000;" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Receive Requests&lt;br&gt;• Health Checks&lt;br&gt;• Distribute Traffic" vertex="1">
          <mxGeometry height="90" width="180" x="390" y="200" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#03a9f4;align=left;spacingLeft=12;fontColor=#000000;" value="&lt;b&gt;Application Server 1&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Validate URL&lt;br&gt;• Generate Base62&lt;br&gt;• Redirect Users" vertex="1">
          <mxGeometry height="100" width="180" x="140" y="360" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#03a9f4;align=left;spacingLeft=12;fontColor=#000000;" value="&lt;b&gt;Application Server 2&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Validate URL&lt;br&gt;• Generate Base62&lt;br&gt;• Redirect Users" vertex="1">
          <mxGeometry height="100" width="180" x="390" y="360" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#03a9f4;align=left;spacingLeft=12;fontColor=#000000;" value="&lt;b&gt;Application Server 3&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Validate URL&lt;br&gt;• Generate Base62&lt;br&gt;• Redirect Users" vertex="1">
          <mxGeometry height="100" width="180" x="640" y="360" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-7" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" value="&lt;b&gt;MySQL Database&lt;/b&gt;&lt;br&gt;(Single Instance)" vertex="1">
          <mxGeometry height="90" width="160" x="400" y="530" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#81c784;align=left;spacingLeft=15;fontColor=#000000;" value="&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ Horizontal Scaling&lt;br&gt;✓ High Availability&lt;br&gt;✓ Better Resource Utilization&lt;br&gt;✓ Fault Tolerance&lt;br&gt;✓ Stateless Servers&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="240" x="870" y="110" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e57373;align=left;spacingLeft=15;fontColor=#000000;" value="&lt;b&gt;Remaining Problems&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font color=&quot;#c62828&quot;&gt;❌ Single Database&lt;br&gt;❌ Database becomes bottleneck&lt;br&gt;❌ Reads overload storage&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="870" y="330" as="geometry" />
        </mxCell>
        <mxCell id="i7BZ-n0yRelE3EM2F2rg-10" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#666666;fontSize=11;" value="Version 2 | Scaling Compute | Diagram 7 of 12" vertex="1">
