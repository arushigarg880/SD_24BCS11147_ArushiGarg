  <diagram id="netflix-hld" name="Netflix HLD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Netflix — High Level Design (HLD)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="System Design Experiment 2" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="620" y="65" width="360" height="30" as="geometry"/>
        </mxCell>

        <!-- Requirements -->
        <mxCell id="fr" value="&lt;b&gt;FUNCTIONAL REQUIREMENTS&lt;/b&gt;&lt;br&gt;• User registration &amp;amp; login&lt;br&gt;• Browse movies / TV shows&lt;br&gt;• Search content&lt;br&gt;• View details&lt;br&gt;• Personalized recommendations&lt;br&gt;• Play / pause / resume&lt;br&gt;• Multiple video qualities&lt;br&gt;• Subtitles &amp;amp; languages&lt;br&gt;• Watch history&lt;br&gt;• My List&lt;br&gt;• Profiles&lt;br&gt;• Subscription &amp;amp; payment&lt;br&gt;• Notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="300" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="nfr" value="&lt;b&gt;NON-FUNCTIONAL REQUIREMENTS&lt;/b&gt;&lt;br&gt;• High availability&lt;br&gt;• Horizontal scalability&lt;br&gt;• Low latency&lt;br&gt;• Reliability&lt;br&gt;• Fault tolerance&lt;br&gt;• Security&lt;br&gt;• Durability&lt;br&gt;• Performance&lt;br&gt;• Resilience during traffic spikes&lt;br&gt;• Global content delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#5b9bd5;fontSize=14;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="500" width="300" height="270" as="geometry"/>
        </mxCell>

        <!-- Estimation -->
        <mxCell id="est" value="&lt;b&gt;BACK-OF-THE-ENVELOPE ESTIMATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assumptions:&lt;br&gt;• Registered users ≈ 300M&lt;br&gt;• DAU ≈ 100M&lt;br&gt;• Peak concurrent users ≈ 30M&lt;br&gt;• Average bitrate ≈ 5 Mbps&lt;br&gt;• Browse/search requests ≈ 1B/day&lt;br&gt;&lt;br&gt;&lt;b&gt;Peak video bandwidth&lt;/b&gt;&lt;br&gt;30M × 5 Mbps ≈ 150 Tbps&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage example&lt;/b&gt;&lt;br&gt;50K titles × 10 GB ≈ 500 TB&lt;br&gt;&lt;br&gt;Multiple resolutions, languages and replicas increase actual storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#ed7d31;fontSize=13;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1270" y="120" width="300" height="360" as="geometry"/>
